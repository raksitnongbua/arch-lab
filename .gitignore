package-lock.json
yarn.lock
bun.lockb

# next.js
/.next/
/out/
/build
next-env.d.ts

# testing
/coverage

# env files (opt in explicitly if one ever needs committing)
.env
.env.*
!.env.example
# Dotless variants too. `node scripts/gen-share-keys.mjs > env` is one missing
# dot away from `.env`, and its output is a PRIVATE signing key — the rules
# above would not have caught it, and `git add -A` would have staged it.
env
env.*

# typescript / tooling caches
*.tsbuildinfo
.eslintcache

# editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# os cruft
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# misc
*.pem
.vercel

# agent tooling and git worktrees. .claude/worktrees holds nested checkouts of
# this same repository, so leaving it untracked but unignored lets `git add -A`
# stage a worktree as an embedded gitlink.
#
# Ignore the CONTENTS rather than the directory itself, so the re-include below
# can reach inside. `.claude/` as a blanket rule cannot be undone by a later
# negation — git never descends into an excluded directory, so `!.claude/rules/`
# under it would never match anything.
.claude/*
# ...except the project rules, which README.md links to and reviewers need to
# see in a diff, and the subagent definitions, which encode the same decisions
# for the agents that do the work — a reviewer who cannot see them cannot tell
# why an agent asserted something. Everything else under .claude/ — worktrees,
# settings.local.json — stays ignored by the line above.
!.claude/rules/
!.claude/agents/

# Agent-captured verification screenshots — evidence, not source.
.claude-screenshots/
