{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["[", "]"],
    ["(", ")"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"", "notIn": ["comment"] },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" }
  ],
  "surroundingPairs": [
    ["\"", "\""],
    ["[", "]"],
    ["(", ")"],
    ["{", "}"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^@(context|container|component|code)\\b.*$",
    "decreaseIndentPattern": "^\\s*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^@(context|container|component|code)\\b.*$",
      "action": { "indent": "indent" }
    }
  ],
  "wordPattern": "[A-Za-z0-9_-]+"
}
